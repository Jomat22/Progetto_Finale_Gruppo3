@baseUrl = http://localhost:5102/api/Client

### 1. Test => Creazione Cliente (successo)
# Nota 1: Assicurarsi che 'PersonId' corrisponda ad un record esistente nella tabella 'persone' e non sia già associato ad un cliente
# Nota 2: Il 'CodiceCliente' deve essere univoco nella tabella 'dipendenti'
POST {{baseUrl}}
Content-Type: application/json

{
  "personId": 31,
  "codiceCliente": "CC-MARIOROSSI-2024..",
  "isFidelizzato": true,
  "isIscrittoNewsletter": true
}

### 2. Test => Errore di Validazione (dati non conformi)
# Fallisce per:
# - codiceCliente troppo lungo (il tuo DB ha varchar(20))
POST {{baseUrl}}
Content-Type: application/json

{
  "personId": 31,
  "codiceCliente": "CC-MARIOROSSI-2024...",
  "isFidelizzato": true,
  "isIscrittoNewsletter": true
}

### 3. Test => Errore Duplicato ('Codice Cliente' già esistente)
# Fallisce perché 'codiceCliente' è Unique nel 'DataContext'
POST {{baseUrl}}
Content-Type: application/json

{
  "personId": 31,
  "codiceCliente": "CC-MARIOROSSI-2024",
  "isFidelizzato": false,
  "isIscrittoNewsletter": false
}